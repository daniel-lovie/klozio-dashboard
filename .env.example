# --- database ---
# local (docker compose): port 5433 to avoid clashing with a system postgres
DATABASE_URL=postgres://klozio:klozio@localhost:5433/klozio
# Railway injects its own DATABASE_URL automatically

# --- dashboard auth (single user) ---
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# --- Etsy app (same values as ../.env) ---
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_API_KEY=
ETSY_SHOP_ID=67236031

# --- scheduler ---
# secret for POST /api/cron/publish so Railway cron (or curl) can trigger it
CRON_SECRET=generate-another-random-string
# set false to disable the in-process ticker (e.g. if using Railway cron only)
ENABLE_INPROCESS_SCHEDULER=true
# how often the in-process ticker checks for due publishes
SCHEDULER_INTERVAL_MS=60000
# never auto-publish anything scheduled more than this far in the past (safety)
PUBLISH_GRACE_MINUTES=180

# Local generation on the DGX Spark. off | internal | percent:N | default_on
# `off` is the kill switch and the default: it restores the hosted-only behaviour with no deploy.
LOCAL_ENGINE=off
