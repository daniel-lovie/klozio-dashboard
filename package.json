{
  "name": "klozio-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/freeport.mjs",
    "dev": "next dev -p 3010",
    "build": "next build",
    "prestart": "node scripts/freeport.mjs",
    "start": "next start -p ${PORT:-3010}",
    "db:up": "docker compose up -d && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mts",
    "db:seed": "node --experimental-strip-types scripts/seed.mts",
    "db:reset": "node --experimental-strip-types scripts/migrate.mts --reset && node --experimental-strip-types scripts/seed.mts",
    "publish:tick": "node --experimental-strip-types scripts/tick.mts",
    "db:sync": "node --experimental-strip-types scripts/sync-state.mts",
    "db:plan": "node --experimental-strip-types scripts/seed-plan.mts",
    "db:attach": "node --experimental-strip-types scripts/attach-images.mts",
    "orders:poll": "curl -s -X POST \"http://localhost:${PORT:-3010}/api/orders/poll?secret=$CRON_SECRET\""
  },
  "dependencies": {
    "image-size": "^2.0.2",
    "next": "^15.5.22",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
